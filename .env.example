# ConsultFlow Dental environment. Copy to .env.local. Never commit real values.

# Demo mode is on unless set to "false". In demo mode no message is ever sent.
NEXT_PUBLIC_DEMO_MODE=true

# Assistant provider: "demo" (default, deterministic, no credentials) or "anthropic".
AI_PROVIDER=demo
# Server-side only. Required when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5-5).
ANTHROPIC_MODEL=

# Future production integrations (not used by the MVP):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# SMS_API_KEY=
# EMAIL_API_KEY=
